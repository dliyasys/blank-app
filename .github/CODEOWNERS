import sys
import time

def ketik_lambat(teks, kecepatan=0.04):
    """Fungsi untuk membuat efek animasi mengetik."""
    for karakter in teks:
        sys.stdout.write(karakter)
        sys.stdout.flush()
        time.sleep(kecepatan)
    print()

